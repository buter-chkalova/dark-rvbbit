; Control driver package
; Configured as demand-start, separate from the main driver

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = DarkRvbbit
DriverVer   = 10/13/2026,1.0.0.0
CatalogFile = dark_rvbbit_ctl.cat

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
dark_rvbbit_ctl.sys = 1,,

[Manufacturer]
%MfgName% = DarkRvbbit,NTamd64

[DarkRvbbit.NTamd64]
%DevName% = DarkRvbbit_Inst, root\dark_rvbbit_ctl

[DarkRvbbit_Inst.NT]
CopyFiles = DarkRvbbit_CopyFiles

[DarkRvbbit_Inst.NT.Services]
AddService = dark_rvbbit_ctl, 0x00000002, DarkRvbbit_Service

[DarkRvbbit_CopyFiles]
dark_rvbbit_ctl.sys

[DarkRvbbit_Service]
DisplayName    = %ServiceName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\dark_rvbbit_ctl.sys

[Strings]
DiskName    = "Dark rvbbit Control"
MfgName     = "Dark rvbbit"
DevName     = "Dark rvbbit Control Channel"
ServiceName = "Dark rvbbit Control"